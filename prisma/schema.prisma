generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  status      String   @default("PLANNING") // PLANNING | LITERATURE_REVIEW | WRITING | REVIEW | COMPLETE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  papers     Paper[]
  sections   PaperSection[]
  milestones Milestone[]
  citations  Citation[]
}

model Paper {
  id        String   @id @default(cuid())
  title     String
  authors   String   @default("")
  abstract  String   @default("")
  url       String   @default("")
  projectId String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PaperSection {
  id          String   @id @default(cuid())
  sectionType String   // ABSTRACT | INTRODUCTION | METHODOLOGY | RESULTS | CONCLUSION
  content     String   @default("")
  order       Int      @default(0)
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Milestone {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  dueDate     DateTime?
  completed   Boolean  @default(false)
  projectId   String
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Citation {
  id           String   @id @default(cuid())
  citationText String
  cslJson      String   @default("")
  projectId    String
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
